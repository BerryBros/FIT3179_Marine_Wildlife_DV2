{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "ALA occurrence point map.",
  "width": "container",
  "height": 470,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "speciesPick",
      "value": "All species",
      "bind": {
        "input": "select",
        "name": "Species: ",
        "options": [
          "All species",
          "Humpback whale",
          "Indo-Pacific bottlenose dolphin",
          "Green turtle",
          "Grey nurse shark",
          "Australian sea lion"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F4EFE4",
        "stroke": "#536B77",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/ala_points.csv"
      },
      "transform": [
        {
          "filter": "speciesPick === 'All species' || datum.species === speciesPick"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 18,
        "opacity": 0.46,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#4F7CAC",
              "#42B7B0",
              "#6DB56D",
              "#D98B3A",
              "#9B75CF"
            ]
          },
          "legend": {
            "title": "Species",
            "orient": "bottom",
            "columns": 2
          }
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "year",
            "title": "Record year",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#EAF6FB"
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333",
      "gridColor": "#DCE7EA"
    },
    "legend": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333"
    },
    "header": {
      "labelFont": "Manrope",
      "titleFont": "Manrope"
    }
  }
}