{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "ALA occurrence point map with high-contrast occurrence marks.",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "speciesPick",
      "value": "All species",
      "bind": {
        "input": "select",
        "name": "Species: ",
        "options": [
          "All species",
          "Humpback whale",
          "Indo-Pacific bottlenose dolphin",
          "Green turtle",
          "Grey nurse shark",
          "Australian sea lion"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F3EFE4",
        "stroke": "#4C6672",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "url": "data/ala_points.csv"
      },
      "transform": [
        {
          "filter": "speciesPick === 'All species' || datum.species === speciesPick"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "condition": {
            "test": "speciesPick !== 'All species'",
            "value": 42
          },
          "value": 27
        },
        "opacity": {
          "condition": {
            "test": "speciesPick !== 'All species'",
            "value": 0.9
          },
          "value": 0.68
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#2F6FB0",
              "#008E8B",
              "#4A9854",
              "#D97706",
              "#7B4FC7"
            ]
          },
          "legend": {
            "title": "Species",
            "orient": "bottom",
            "columns": 3,
            "symbolOpacity": 1,
            "symbolSize": 90
          }
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "year",
            "title": "Record year",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#DFF1F4"
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333",
      "gridColor": "#DCE7EA"
    },
    "legend": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#334B58",
      "titleColor": "#102333"
    }
  }
}