{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bipartite network linking focal species to documented pressures, with pressure-side counts.",
  "width": 780,
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/threat_matrix.csv",
    "format": {
      "type": "csv",
      "parse": {
        "documented": "number"
      }
    }
  },
  "params": [
    {
      "name": "networkFocus",
      "value": "All species",
      "bind": {
        "input": "select",
        "name": "Focus species: ",
        "options": [
          "All species",
          "Humpback whale",
          "Indo-Pacific bottlenose dolphin",
          "Green turtle",
          "Grey nurse shark",
          "Australian sea lion"
        ]
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "calculate": "0",
          "as": "sx"
        },
        {
          "calculate": "1",
          "as": "tx"
        },
        {
          "calculate": "indexof(['Humpback whale','Indo-Pacific bottlenose dolphin','Green turtle','Grey nurse shark','Australian sea lion'], datum.species) + 1",
          "as": "sy"
        },
        {
          "calculate": "indexof(['Fishing / bycatch','Entanglement / debris','Climate / heat','Habitat change','Vessels / noise / protection gear'], datum.threat) + 1",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "field": "sx",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "tx"
        },
        "y": {
          "field": "sy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "ty"
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#2F6FB0",
              "#008E8B",
              "#4A9854",
              "#D97706",
              "#7B4FC7"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 0.72
          },
          "value": 0.08
        },
        "strokeWidth": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 2.7
          },
          "value": 1.0
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "threat",
            "title": "Documented pressure"
          },
          {
            "field": "note",
            "title": "Source note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "species"
          ]
        },
        {
          "calculate": "0",
          "as": "xpos"
        },
        {
          "calculate": "indexof(['Humpback whale','Indo-Pacific bottlenose dolphin','Green turtle','Grey nurse shark','Australian sea lion'], datum.species) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.7
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ypos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "size": {
          "field": "degree",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              220,
              700
            ]
          },
          "legend": null
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#2F6FB0",
              "#008E8B",
              "#4A9854",
              "#D97706",
              "#7B4FC7"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 1
          },
          "value": 0.28
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "species"
          ]
        },
        {
          "calculate": "0",
          "as": "xpos"
        },
        {
          "calculate": "indexof(['Humpback whale','Indo-Pacific bottlenose dolphin','Green turtle','Grey nurse shark','Australian sea lion'], datum.species) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -15,
        "fontSize": 12,
        "fontWeight": 750,
        "color": "#1F3440"
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ypos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "species"
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 1
          },
          "value": 0.38
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "threat"
          ]
        },
        {
          "calculate": "1",
          "as": "xpos"
        },
        {
          "calculate": "indexof(['Fishing / bycatch','Entanglement / debris','Climate / heat','Habitat change','Vessels / noise / protection gear'], datum.threat) + 1",
          "as": "ypos"
        },
        {
          "calculate": "datum.threat + '  \u00b7  ' + datum.degree + (datum.degree === 1 ? ' species' : ' species')",
          "as": "pressure_label"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#17495A",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.7
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ypos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "size": {
          "field": "degree",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              220,
              760
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "threat",
            "title": "Pressure"
          },
          {
            "field": "degree",
            "title": "Focal species linked"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "threat"
          ]
        },
        {
          "calculate": "1",
          "as": "xpos"
        },
        {
          "calculate": "indexof(['Fishing / bycatch','Entanglement / debris','Climate / heat','Habitat change','Vessels / noise / protection gear'], datum.threat) + 1",
          "as": "ypos"
        },
        {
          "calculate": "datum.threat + '  \u00b7  ' + datum.degree + ' species'",
          "as": "pressure_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 15,
        "fontSize": 12,
        "fontWeight": 750,
        "color": "#1F3440",
        "limit": 255
      },
      "encoding": {
        "x": {
          "field": "xpos",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ypos",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "pressure_label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0,
            "y": 0.34,
            "label": "FOCAL SPECIES"
          },
          {
            "x": 1,
            "y": 0.34,
            "label": "DOCUMENTED PRESSURES"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 800,
        "color": "#6A7E89",
        "letterSpacing": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.48,
              1.56
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.25,
              5.55
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope"
    }
  }
}