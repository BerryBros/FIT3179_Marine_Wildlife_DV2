{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bipartite network linking focal marine species to documented pressure categories.",
  "width": 760,
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/threat_matrix.csv",
    "format": {
      "type": "csv",
      "parse": {
        "documented": "number"
      }
    }
  },
  "params": [
    {
      "name": "networkFocus",
      "value": "All species",
      "bind": {
        "input": "select",
        "name": "Focus species: ",
        "options": [
          "All species",
          "Humpback whale",
          "Indo-Pacific bottlenose dolphin",
          "Green turtle",
          "Grey nurse shark",
          "Australian sea lion"
        ]
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "calculate": "0",
          "as": "sx"
        },
        {
          "calculate": "1",
          "as": "tx"
        },
        {
          "calculate": "indexof([\"Humpback whale\", \"Indo-Pacific bottlenose dolphin\", \"Green turtle\", \"Grey nurse shark\", \"Australian sea lion\"], datum.species) + 1",
          "as": "sy"
        },
        {
          "calculate": "indexof([\"Fishing / bycatch\", \"Entanglement / debris\", \"Climate / heat\", \"Habitat change\", \"Vessels / noise / protection gear\"], datum.threat) + 1",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.42,
              1.42
            ]
          },
          "axis": null,
          "field": "sx"
        },
        "x2": {
          "field": "tx"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              5.5
            ],
            "reverse": true
          },
          "axis": null,
          "field": "sy"
        },
        "y2": {
          "field": "ty"
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#4F7CAC",
              "#42B7B0",
              "#6DB56D",
              "#D98B3A",
              "#9B75CF"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 0.68
          },
          "value": 0.08
        },
        "strokeWidth": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 2.5
          },
          "value": 1.0
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "threat",
            "title": "Documented pressure"
          },
          {
            "field": "note",
            "title": "Source note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "species"
          ]
        },
        {
          "calculate": "0",
          "as": "xpos"
        },
        {
          "calculate": "indexof([\"Humpback whale\", \"Indo-Pacific bottlenose dolphin\", \"Green turtle\", \"Grey nurse shark\", \"Australian sea lion\"], datum.species) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.42,
              1.42
            ]
          },
          "axis": null,
          "field": "xpos"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              5.5
            ],
            "reverse": true
          },
          "axis": null,
          "field": "ypos"
        },
        "size": {
          "field": "degree",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              180,
              650
            ]
          },
          "legend": null
        },
        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Humpback whale",
              "Indo-Pacific bottlenose dolphin",
              "Green turtle",
              "Grey nurse shark",
              "Australian sea lion"
            ],
            "range": [
              "#4F7CAC",
              "#42B7B0",
              "#6DB56D",
              "#D98B3A",
              "#9B75CF"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 1
          },
          "value": 0.28
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "degree",
            "title": "Documented pressure links"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "species"
          ]
        },
        {
          "calculate": "0",
          "as": "xpos"
        },
        {
          "calculate": "indexof([\"Humpback whale\", \"Indo-Pacific bottlenose dolphin\", \"Green turtle\", \"Grey nurse shark\", \"Australian sea lion\"], datum.species) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -14,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#263B49"
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.42,
              1.42
            ]
          },
          "axis": null,
          "field": "xpos"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              5.5
            ],
            "reverse": true
          },
          "axis": null,
          "field": "ypos"
        },
        "text": {
          "field": "species"
        },
        "opacity": {
          "condition": {
            "test": "networkFocus === 'All species' || datum.species === networkFocus",
            "value": 1
          },
          "value": 0.35
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "threat"
          ]
        },
        {
          "calculate": "1",
          "as": "xpos"
        },
        {
          "calculate": "indexof([\"Fishing / bycatch\", \"Entanglement / debris\", \"Climate / heat\", \"Habitat change\", \"Vessels / noise / protection gear\"], datum.threat) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.42,
              1.42
            ]
          },
          "axis": null,
          "field": "xpos"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              5.5
            ],
            "reverse": true
          },
          "axis": null,
          "field": "ypos"
        },
        "size": {
          "field": "degree",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              180,
              650
            ]
          },
          "legend": null
        },
        "color": {
          "field": "threat",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fishing / bycatch",
              "Entanglement / debris",
              "Climate / heat",
              "Habitat change",
              "Vessels / noise / protection gear"
            ],
            "range": [
              "#D95F4A",
              "#E29555",
              "#B78BC7",
              "#7AA6A1",
              "#667C99"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "threat",
            "title": "Pressure"
          },
          {
            "field": "degree",
            "title": "Focal species linked"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.documented === 1"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "degree"
            }
          ],
          "groupby": [
            "threat"
          ]
        },
        {
          "calculate": "1",
          "as": "xpos"
        },
        {
          "calculate": "indexof([\"Fishing / bycatch\", \"Entanglement / debris\", \"Climate / heat\", \"Habitat change\", \"Vessels / noise / protection gear\"], datum.threat) + 1",
          "as": "ypos"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#263B49",
        "limit": 220
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.42,
              1.42
            ]
          },
          "axis": null,
          "field": "xpos"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              5.5
            ],
            "reverse": true
          },
          "axis": null,
          "field": "ypos"
        },
        "text": {
          "field": "threat"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope"
    }
  }
}