{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Species x behaviour matrix of mapped Biologically Important Area (km2, square-root colour scale).",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/bia_park_overlap.csv"
  },
  "transform": [
    {
      "filter": "datum.behaviour !== 'All behaviours'"
    },
    {
      "impute": "bia_area_km2",
      "key": "behaviour",
      "groupby": [
        "species"
      ],
      "keyvals": [
        "Migration",
        "Reproduction",
        "Foraging",
        "Resting"
      ],
      "value": null
    },
    {
      "calculate": "isValid(datum.bia_area_km2) ? (datum.bia_area_km2 >= 1000 ? format(datum.bia_area_km2/1000, '.0f') + 'k' : format(datum.bia_area_km2, '.0f')) : 'N/A'",
      "as": "cell_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "title": null,
      "sort": [
        "Humpback whale",
        "Indo-Pacific bottlenose dolphin",
        "Green turtle",
        "Grey nurse shark",
        "Australian sea lion"
      ],
      "axis": {
        "labelLimit": 230,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "behaviour",
      "type": "nominal",
      "title": null,
      "sort": [
        "Migration",
        "Reproduction",
        "Foraging",
        "Resting"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "fill": "#DCE8E6",
        "stroke": "#F4F7F6",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "behaviour",
            "title": "Behaviour"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.bia_area_km2)"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "#F4F7F6",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "bia_area_km2",
          "type": "quantitative",
          "title": "Mapped area (km\u00b2)",
          "scale": {
            "type": "sqrt",
            "scheme": "tealblues"
          },
          "legend": {
            "format": "~s",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "field": "species",
            "title": "Species"
          },
          {
            "field": "behaviour",
            "title": "Behaviour"
          },
          {
            "field": "bia_area_km2",
            "title": "Mapped area (km\u00b2)",
            "format": ",.0f"
          },
          {
            "field": "feature_count",
            "title": "Polygons drawn"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontWeight": 800,
        "fontSize": 13
      },
      "encoding": {
        "text": {
          "field": "cell_label"
        },
        "color": {
          "condition": [
            {
              "test": "!isValid(datum.bia_area_km2)",
              "value": "#74878B"
            },
            {
              "test": "datum.bia_area_km2 > 120000",
              "value": "#FFFFFF"
            }
          ],
          "value": "#10303D"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}