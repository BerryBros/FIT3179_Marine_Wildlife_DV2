{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Discrete EPBC status classification for the five focal species/populations.",
  "width": "container",
  "height": 305,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/conservation_status.csv",
    "format": {
      "type": "csv",
      "parse": {
        "status_rank": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.status === 'Critically Endangered' ? 'CE' : datum.status === 'Endangered' ? 'EN' : datum.status === 'Vulnerable' ? 'VU' : '\u2014'",
      "as": "status_short"
    }
  ],
  "encoding": {
    "y": {
      "field": "display_species",
      "type": "nominal",
      "sort": [
        "Grey nurse shark (east coast population)",
        "Australian sea lion",
        "Green turtle",
        "Humpback whale",
        "Indo-Pacific bottlenose dolphin"
      ],
      "title": null,
      "axis": {
        "labelLimit": 235,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "status",
      "type": "ordinal",
      "sort": [
        "Not EPBC threatened",
        "Vulnerable",
        "Endangered",
        "Critically Endangered"
      ],
      "title": "EPBC listing category",
      "axis": {
        "labelExpr": "datum.label === 'Not EPBC threatened' ? 'Not listed' : datum.label",
        "labelAngle": 0,
        "labelLimit": 150,
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "square",
        "filled": true,
        "size": 700,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "status",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Not EPBC threatened",
              "Vulnerable",
              "Endangered",
              "Critically Endangered"
            ],
            "range": [
              "#94A6AE",
              "#D8AE50",
              "#E47B54",
              "#B84D60"
            ]
          }
        },
        "tooltip": [
          {
            "field": "display_species",
            "title": "Species / population"
          },
          {
            "field": "status",
            "title": "EPBC status"
          },
          {
            "field": "listing_note",
            "title": "Context"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 800,
        "color": "#FFFFFF"
      },
      "encoding": {
        "text": {
          "field": "status_short"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333",
      "gridColor": "#E0E8EB",
      "domainColor": "#A9BCC3",
      "tickColor": "#A9BCC3"
    }
  }
}