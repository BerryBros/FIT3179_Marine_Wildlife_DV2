{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Marine Parks and BIA overlay.",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "overlaySpecies",
      "value": "Green turtle",
      "bind": {
        "input": "select",
        "name": "Species: ",
        "options": [
          "Humpback whale",
          "Indo-Pacific bottlenose dolphin",
          "Green turtle",
          "Grey nurse shark",
          "Australian sea lion"
        ]
      }
    },
    {
      "name": "overlayBehaviour",
      "value": "All behaviours",
      "bind": {
        "input": "select",
        "name": "BIA behaviour: ",
        "options": [
          "All behaviours",
          "Migration",
          "Reproduction",
          "Foraging",
          "Resting"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F4EFE4",
        "stroke": "#536B77",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/marine_parks_outer_vega.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#18A89D",
        "fillOpacity": 0.22,
        "stroke": "#0E7F78",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.park",
            "title": "Marine park"
          },
          {
            "field": "properties.network",
            "title": "Network"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/bia_selected_vega.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.species === overlaySpecies"
        },
        {
          "filter": "overlayBehaviour === 'All behaviours' || datum.properties.behaviour === overlayBehaviour"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0.02,
        "stroke": "#E57E25",
        "strokeWidth": 1.6,
        "strokeDash": [
          7,
          4
        ]
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.species",
            "title": "Species"
          },
          {
            "field": "properties.behaviour",
            "title": "BIA behaviour"
          },
          {
            "field": "properties.location",
            "title": "BIA location"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#EAF6FB"
    },
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333",
      "gridColor": "#DCE7EA"
    },
    "legend": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelColor": "#405363",
      "titleColor": "#102333"
    },
    "header": {
      "labelFont": "Manrope",
      "titleFont": "Manrope"
    }
  }
}