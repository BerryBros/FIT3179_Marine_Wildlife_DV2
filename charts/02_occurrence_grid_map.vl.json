{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Aggregated ALA occurrence concentration by two-degree cells.",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F4EFE4",
        "stroke": "#536B77",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/ala_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "record_count": "number",
            "species_count": "number",
            "grid_lon": "number",
            "grid_lat": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.62,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "grid_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "grid_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "record_count",
          "type": "quantitative",
          "title": "ALA records in 2\u00b0 cell",
          "scale": {
            "type": "sqrt",
            "range": [
              18,
              900
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolOpacity": 0.7,
            "format": "~s",
            "titleLimit": 260
          }
        },
        "color": {
          "field": "species_count",
          "type": "quantitative",
          "title": "Focal species represented",
          "scale": {
            "domain": [
              1,
              5
            ],
            "scheme": "tealblues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 180,
            "tickCount": 5
          }
        },
        "tooltip": [
          {
            "field": "record_count",
            "title": "ALA records",
            "format": ","
          },
          {
            "field": "species_count",
            "title": "Focal species",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ala_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "record_count": "number",
            "species_count": "number",
            "grid_lon": "number",
            "grid_lat": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "rk"
            }
          ],
          "sort": [
            {
              "field": "record_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rk <= 3"
        },
        {
          "calculate": "datum.rk === 1 ? 'Pilbara coast, WA' : datum.rk === 2 ? 'Central Qld coast' : 'Great Australian Bight'",
          "as": "place"
        },
        {
          "calculate": "[datum.place, format(datum.record_count, ',') + ' records']",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 700,
        "color": "#17313F",
        "lineHeight": 13,
        "dy": -30
      },
      "encoding": {
        "longitude": {
          "field": "grid_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "grid_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#EAF6FB"
    },
    "axis": {
      "labelColor": "#405363",
      "titleColor": "#102333",
      "gridColor": "#DCE7EA"
    },
    "legend": {
      "labelColor": "#405363",
      "titleColor": "#102333"
    },
    "header": {}
  }
}